# Copie este archivo como .env y ajuste los valores.
#   Windows:      copy .env.example .env
#   Linux/macOS:  cp .env.example .env
#
# .env NO debe subirse al repositorio (ya está en .gitignore).

# --- Entorno ---
# development | production | testing
FLASK_ENV=development

# --- Claves secretas (OBLIGATORIO cambiarlas en producción) ---
# Genere cada una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambie-esta-clave-por-una-aleatoria-de-al-menos-32-caracteres
JWT_SECRET_KEY=cambie-tambien-esta-clave-y-que-sea-distinta-de-la-anterior

# --- Base de datos ---
# SQLite (por defecto):
DATABASE_URL=sqlite:///alcaldias.db
# PostgreSQL:
# DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/innova

# --- Servidor de desarrollo (run.py) ---
# HOST=0.0.0.0 expone el depurador de Werkzeug a toda la red: no lo use con FLASK_DEBUG=True.
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=True

# --- Registro de eventos ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Correo saliente (opcional) ---
# Valores por defecto del sistema. Cada municipio puede definir el suyo
# desde /admin/smtp-config, que tiene prioridad sobre estos.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=su-correo@gmail.com
MAIL_PASSWORD=su-contrasena-de-aplicacion
MAIL_DEFAULT_SENDER=Sistema de Gestión <noreply@alcaldia.gov.co>
